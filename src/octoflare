#
# This file is the bootstrap entry point. All functionality lives in the
# modules under lib/ (see OCTOFLARE_MODULES below). When a module is missing
# it is downloaded automatically from the Octoflare repository so that an
# unattended run (CI, GitHub Actions) never fails just because a file or a
# dependency (curl, jq) is not present.

set -uo pipefail

#####################################################################################################################VDM
######################################## Program identity

PROGRAM_NAME="Octoflare"
PROGRAM_CODE="octoflare"
PROGRAM_VERSION="2.0.0"
PROGRAM_V="2.0"
PROGRAM_REPO="${OCTOFLARE_REPO:-octoleo/octoflare}"
PROGRAM_URL="https://github.com/${PROGRAM_REPO}"

# Git reference (branch or tag) used when downloading modules and updates.
OCTOFLARE_REF="${OCTOFLARE_REF:-master}"
OCTOFLARE_RAW_BASE="${OCTOFLARE_RAW_BASE:-https://raw.githubusercontent.com/${PROGRAM_REPO}}"

# Modules loaded in this order. core and api must come first.
OCTOFLARE_MODULES="${OCTOFLARE_MODULES:-core api help zone dns setting cache security rules pagerule ssl workers pages tunnel email turnstile r2 account analytics batch}"

export PROGRAM_NAME PROGRAM_CODE PROGRAM_VERSION PROGRAM_V PROGRAM_REPO PROGRAM_URL OCTOFLARE_REF OCTOFLARE_RAW_BASE OCTOFLARE_MODULES

#####################################################################################################################VDM
######################################## Bootstrap helpers (available before the modules are loaded)

# bootLog - Minimal logger used until core.sh is loaded (always to stderr)
bootLog() {
  local level="$1"; shift
  if [[ "${OCTOFLARE_QUIET:-false}" == "true" && "$level" != "error" ]]; then
    return 0
  fi
  printf '[%s] %s\n' "$level" "$*" >&2
}

# hasCmd - Check whether a command exists on the PATH
hasCmd() {
  command -v "$1" >/dev/null 2>&1
}

# scriptDir - Resolve the directory that holds this script (follows symlinks)
scriptDir() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

# isUnattended - True when running without a human (CI, GitHub Actions, --unattended, --yes)
isUnattended() {
  [[ "${OCTOFLARE_UNATTENDED:-false}" == "true" ]]
}

# detectUnattended - Pre-scan the arguments and environment for unattended markers
detectUnattended() {
  OCTOFLARE_QUIET="${OCTOFLARE_QUIET:-false}"
  OCTOFLARE_DEBUG="${OCTOFLARE_DEBUG:-false}"
  local arg
  if [[ "${OCTOFLARE_UNATTENDED:-}" == "true" || "${OCTOFLARE_UNATTENDED:-}" == "1" ]]; then
    OCTOFLARE_UNATTENDED=true
  elif [[ "${GITHUB_ACTIONS:-}" == "true" || "${CI:-}" == "true" || "${CI:-}" == "1" || -n "${GITLAB_CI:-}" || -n "${BUILDKITE:-}" || -n "${JENKINS_URL:-}" ]]; then
    OCTOFLARE_UNATTENDED=true
  else
    OCTOFLARE_UNATTENDED=false
  fi
  for arg in "$@"; do
    case "$arg" in
      --unattended|--unattended=true|--yes|--yes=true|-y) OCTOFLARE_UNATTENDED=true ;;
      --unattended=false|--no-unattended) OCTOFLARE_UNATTENDED=false ;;
      --quiet|-q) OCTOFLARE_QUIET=true ;;
      --debug) OCTOFLARE_DEBUG=true ;;
    esac
  done
  export OCTOFLARE_UNATTENDED OCTOFLARE_QUIET OCTOFLARE_DEBUG
}

# download - Fetch a URL to a file using whatever downloader is available
#
# Arguments:
#   $1: URL
#   $2: Destination file
download() {
  local url="$1" dest="$2"
  if hasCmd curl; then
    curl -fsSL --retry 3 --retry-delay 2 -o "$dest" "$url"
  elif hasCmd wget; then
    wget -q -O "$dest" "$url"
  elif hasCmd python3; then
    python3 - "$url" "$dest" <<'PY'
import sys, urllib.request
urllib.request.urlretrieve(sys.argv[1], sys.argv[2])
PY
  else
    bootLog error "No downloader available (curl, wget or python3 required) to fetch ${url}"
    return 1
  fi
}

# sudoCmd - Run a command as root when we are not root (non-interactive sudo only)
sudoCmd() {
  if [[ "$(id -u)" == "0" ]]; then
    "$@"
  elif hasCmd sudo; then
    if isUnattended; then
      sudo -n "$@"
    else
      sudo "$@"
    fi
  else
    return 1
  fi
}

# detectPackageManager - Print the name of the system package manager
detectPackageManager() {
  local pm
  for pm in apt-get dnf yum apk pacman zypper brew; do
    if hasCmd "$pm"; then
      echo "$pm"
      return 0
    fi
  done
  return 1
}

# installPackage - Install a system package using the detected package manager
installPackage() {
  local pkg="$1" pm
  pm="$(detectPackageManager)" || {
    bootLog warn "No supported package manager found to install ${pkg}"
    return 1
  }
  bootLog info "Installing ${pkg} with ${pm}..."
  case "$pm" in
    apt-get)
      sudoCmd env DEBIAN_FRONTEND=noninteractive apt-get update -qq >/dev/null 2>&1 || true
      sudoCmd env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$pkg" >/dev/null
      ;;
    dnf) sudoCmd dnf install -y -q "$pkg" >/dev/null ;;
    yum) sudoCmd yum install -y -q "$pkg" >/dev/null ;;
    apk) sudoCmd apk add --no-cache -q "$pkg" >/dev/null ;;
    pacman) sudoCmd pacman -Sy --noconfirm --quiet "$pkg" >/dev/null ;;
    zypper) sudoCmd zypper --non-interactive --quiet install "$pkg" >/dev/null ;;
    brew) brew install "$pkg" >/dev/null ;;
    *) return 1 ;;
  esac
}

# octoflareHome - The per-user data directory used for downloaded modules and binaries
octoflareHome() {
  echo "${OCTOFLARE_HOME:-${XDG_DATA_HOME:-${HOME:-/tmp}/.local/share}/${PROGRAM_CODE}}"
}

# installStaticBinary - Download a static binary as a last resort (no root needed)
#
# Arguments:
#   $1: command name (jq|curl)
installStaticBinary() {
  local name="$1" arch os url bin_dir target
  arch="$(uname -m)"
  os="$(uname -s | tr '[:upper:]' '[:lower:]')"
  bin_dir="$(octoflareHome)/bin"
  mkdir -p "$bin_dir" || return 1
  target="${bin_dir}/${name}"
  case "$name" in
    jq)
      case "${os}-${arch}" in
        linux-x86_64) url="https://github.com/jqlang/jq/releases/latest/download/jq-linux-amd64" ;;
        linux-aarch64|linux-arm64) url="https://github.com/jqlang/jq/releases/latest/download/jq-linux-arm64" ;;
        linux-i386|linux-i686) url="https://github.com/jqlang/jq/releases/latest/download/jq-linux-i386" ;;
        darwin-x86_64) url="https://github.com/jqlang/jq/releases/latest/download/jq-macos-amd64" ;;
        darwin-arm64) url="https://github.com/jqlang/jq/releases/latest/download/jq-macos-arm64" ;;
        *) bootLog error "No static jq build known for ${os}-${arch}"; return 1 ;;
      esac
      ;;
    curl)
      case "${os}-${arch}" in
        linux-x86_64) url="https://github.com/moparisthebest/static-curl/releases/latest/download/curl-amd64" ;;
        linux-aarch64|linux-arm64) url="https://github.com/moparisthebest/static-curl/releases/latest/download/curl-aarch64" ;;
        *) bootLog error "No static curl build known for ${os}-${arch}"; return 1 ;;
      esac
      ;;
    *) return 1 ;;
  esac
  bootLog info "Downloading static ${name} binary to ${target}..."
  download "$url" "$target" || return 1
  chmod +x "$target" || return 1
  export PATH="${bin_dir}:${PATH}"
  hasCmd "$name"
}

# ensureDependency - Make sure a required command exists, installing it when allowed
#
# Arguments:
#   $1: command name
#   $2: package name (defaults to the command name)
ensureDependency() {
  local cmd="$1" pkg="${2:-$1}" answer=""
  local bin_dir
  bin_dir="$(octoflareHome)/bin"
  [[ -d "$bin_dir" ]] && export PATH="${bin_dir}:${PATH}"
  hasCmd "$cmd" && return 0

  if ! isUnattended && [[ "${OCTOFLARE_YES:-false}" != "true" ]]; then
    if [[ -t 0 ]]; then
      printf '[prompt] %s requires "%s" which is not installed. Install it now? [Y/n] ' "$PROGRAM_NAME" "$cmd" >&2
      read -r answer
      case "$answer" in
        n|N|no|NO|No) bootLog error "Cannot continue without ${cmd}. Install it and try again."; exit 69 ;;
      esac
    else
      bootLog error "Missing dependency \"${cmd}\". Re-run with --unattended (or --yes) to install it automatically."
      exit 69
    fi
  fi

  if installPackage "$pkg" 2>/dev/null && hasCmd "$cmd"; then
    bootLog success "Installed ${cmd}."
    return 0
  fi
  if installStaticBinary "$cmd"; then
    bootLog success "Installed ${cmd} (static binary in $(octoflareHome)/bin)."
    return 0
  fi
  bootLog error "Unable to install \"${cmd}\" automatically. Install it manually and try again."
  exit 69
}

# resolveLibDir - Find (or choose) the directory that holds the lib modules
#
# Search order:
#   1. OCTOFLARE_LIB_DIR (explicit)
#   2. <script dir>/lib           (repository checkout, GitHub Action path)
#   3. <script dir>/../lib/octoflare  (e.g. /usr/local/bin -> /usr/local/lib/octoflare)
#   4. $OCTOFLARE_HOME/lib        (per-user auto-install location)
resolveLibDir() {
  local sdir candidate
  sdir="$(scriptDir)"
  local candidates=("${OCTOFLARE_LIB_DIR:-}" "${sdir}/lib" "${sdir}/../lib/${PROGRAM_CODE}" "$(octoflareHome)/lib")
  for candidate in "${candidates[@]}"; do
    [[ -n "$candidate" && -f "${candidate}/core.sh" ]] && { echo "$candidate"; return 0; }
  done
  # Nothing installed yet: pick the first writable location
  for candidate in "${candidates[@]}"; do
    [[ -z "$candidate" ]] && continue
    if mkdir -p "$candidate" 2>/dev/null && [[ -w "$candidate" ]]; then
      echo "$candidate"
      return 0
    fi
  done
  echo "$(octoflareHome)/lib"
}

# fetchModule - Download a single module into the lib directory
fetchModule() {
  local name="$1" dir="$2" url tmp
  url="${OCTOFLARE_RAW_BASE}/${OCTOFLARE_REF}/src/lib/${name}.sh"
  tmp="${dir}/.${name}.sh.tmp"
  mkdir -p "$dir" 2>/dev/null || sudoCmd mkdir -p "$dir" || return 1
  if [[ -w "$dir" ]]; then
    download "$url" "$tmp" && mv "$tmp" "${dir}/${name}.sh"
  else
    tmp="$(mktemp 2>/dev/null || echo "/tmp/octoflare.${name}.$$")"
    download "$url" "$tmp" && sudoCmd mv "$tmp" "${dir}/${name}.sh"
  fi
}

# ensureModules - Download every missing module, then source them all
ensureModules() {
  local dir="$1" name missing=""
  for name in $OCTOFLARE_MODULES; do
    [[ -f "${dir}/${name}.sh" ]] || missing="${missing} ${name}"
  done
  if [[ -n "$missing" ]]; then
    bootLog info "Installing missing ${PROGRAM_NAME} modules (${missing# }) into ${dir}..."
    for name in $missing; do
      fetchModule "$name" "$dir" || {
        bootLog error "Failed to download module \"${name}\" from ${OCTOFLARE_RAW_BASE}/${OCTOFLARE_REF}/src/lib/${name}.sh"
        exit 70
      }
    done
  fi
  for name in $OCTOFLARE_MODULES; do
    # shellcheck disable=SC1090
    source "${dir}/${name}.sh" || {
      bootLog error "Failed to load module \"${name}\" from ${dir}"
      exit 70
    }
  done
}

#####################################################################################################################VDM
######################################## Bootstrap

# Names of the variables that were really present in the environment when Octoflare started
# (env files may set anything else, including OCTOFLARE_* switches that modules default later).
OCTOFLARE_ORIG_ENV=" $(compgen -e | tr '\n' ' ') "
export OCTOFLARE_ORIG_ENV

detectUnattended "$@"

# Dependencies: curl for the Cloudflare API, jq for JSON handling.
ensureDependency curl curl
ensureDependency jq jq

if [[ "${OCTOFLARE_BUNDLED:-false}" != "true" ]]; then
  OCTOFLARE_LIB_DIR="$(resolveLibDir)"
  export OCTOFLARE_LIB_DIR
  ensureModules "$OCTOFLARE_LIB_DIR"
fi

if [[ "${OCTOFLARE_LIB_VERSION:-}" != "$PROGRAM_VERSION" ]]; then
  bootLog warn "Module version (${OCTOFLARE_LIB_VERSION:-unknown}) differs from ${PROGRAM_NAME} v${PROGRAM_VERSION}; run '${PROGRAM_CODE} --update' to synchronise."
fi

#####################################################################################################################VDM
######################################## Run Main

octoflareMain "$@"
