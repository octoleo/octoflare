# This file is the bootstrap entry point. All functionality lives in the
# modules under lib/ (see OCTOFLARE_MODULES below). When a module is missing
# it is downloaded automatically from the Octoflare repository so that an
# unattended run (CI, GitHub Actions) never fails just because a file or a
# dependency (curl, jq) is not present.

set -uo pipefail

#####################################################################################################################VDM
######################################## Program identity

PROGRAM_NAME="Octoflare"
PROGRAM_CODE="octoflare"
PROGRAM_VERSION="2.0.0"
PROGRAM_V="2.0"
PROGRAM_REPO="${OCTOFLARE_REPO:-octoleo/octoflare}"
PROGRAM_URL="https://github.com/${PROGRAM_REPO}"

# Git reference (branch or tag) used when downloading modules and updates.
OCTOFLARE_REF="${OCTOFLARE_REF:-master}"
OCTOFLARE_RAW_BASE="${OCTOFLARE_RAW_BASE:-https://raw.githubusercontent.com/${PROGRAM_REPO}}"

# Modules loaded in this order. core and api must come first.
OCTOFLARE_MODULES="${OCTOFLARE_MODULES:-core api help zone dns setting cache security rules pagerule ssl workers pages tunnel email turnstile r2 account analytics batch}"

export PROGRAM_NAME PROGRAM_CODE PROGRAM_VERSION PROGRAM_V PROGRAM_REPO PROGRAM_URL OCTOFLARE_REF OCTOFLARE_RAW_BASE OCTOFLARE_MODULES

#####################################################################################################################VDM
######################################## Bootstrap helpers (available before the modules are loaded)

# bootLog - Minimal logger used until core.sh is loaded (always to stderr)
#
# Under GITHUB_ACTIONS=true errors and warnings are also written as ::error / ::warning
# workflow commands (to stderr as well, so stdout stays clean for --json consumers), so a
# bootstrap failure (dependency or module install) is annotated like a core.sh error.
bootLog() {
  local level="$1"; shift
  if [[ "${OCTOFLARE_QUIET:-false}" == "true" && "$level" != "error" ]]; then
    return 0
  fi
  printf '[%s] %s\n' "$level" "$*" >&2
  if [[ "${GITHUB_ACTIONS:-}" == "true" ]]; then
    case "$level" in
      error) printf '::error title=%s::%s\n' "$PROGRAM_NAME" "$*" >&2 ;;
      warn) printf '::warning title=%s::%s\n' "$PROGRAM_NAME" "$*" >&2 ;;
    esac
  fi
}

# hasCmd - Check whether a command exists on the PATH
hasCmd() {
  command -v "$1" >/dev/null 2>&1
}

# scriptDir - Resolve the directory that holds this script (follows symlinks)
scriptDir() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

# isUnattended - True when running without a human (CI, GitHub Actions, --unattended, --yes)
isUnattended() {
  [[ "${OCTOFLARE_UNATTENDED:-false}" == "true" ]]
}

# detectUnattended - Pre-scan the arguments and environment for unattended markers
detectUnattended() {
  OCTOFLARE_QUIET="${OCTOFLARE_QUIET:-false}"
  OCTOFLARE_DEBUG="${OCTOFLARE_DEBUG:-false}"
  local arg
  if [[ "${OCTOFLARE_UNATTENDED:-}" == "true" || "${OCTOFLARE_UNATTENDED:-}" == "1" ]]; then
    OCTOFLARE_UNATTENDED=true
  elif [[ "${GITHUB_ACTIONS:-}" == "true" || "${CI:-}" == "true" || "${CI:-}" == "1" || -n "${GITLAB_CI:-}" || -n "${BUILDKITE:-}" || -n "${JENKINS_URL:-}" ]]; then
    OCTOFLARE_UNATTENDED=true
  else
    OCTOFLARE_UNATTENDED=false
  fi
  for arg in "$@"; do
    case "$arg" in
      --unattended|--unattended=true|--yes|--yes=true|-y) OCTOFLARE_UNATTENDED=true ;;
      --unattended=false|--no-unattended) OCTOFLARE_UNATTENDED=false ;;
      --quiet|-q) OCTOFLARE_QUIET=true ;;
      --debug) OCTOFLARE_DEBUG=true ;;
    esac
  done
  export OCTOFLARE_UNATTENDED OCTOFLARE_QUIET OCTOFLARE_DEBUG
}

# download - Fetch a URL to a file using whatever downloader is available
#
# Every downloader is bounded in time (connect 15s, whole transfer OCTOFLARE_TIMEOUT,
# default 60s) so an unattended run fails instead of hanging on a silent proxy.
#
# Arguments:
#   $1: URL
#   $2: Destination file
download() {
  local url="$1" dest="$2" max_time="${OCTOFLARE_TIMEOUT:-60}"
  if hasCmd curl; then
    curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 15 --max-time "$max_time" -o "$dest" "$url"
  elif hasCmd wget; then
    wget -q --timeout=15 --tries=3 -O "$dest" "$url"
  elif hasCmd python3; then
    python3 - "$url" "$dest" "$max_time" <<'PY'
import sys, urllib.request
with urllib.request.urlopen(sys.argv[1], timeout=float(sys.argv[3])) as r, open(sys.argv[2], 'wb') as f:
    f.write(r.read())
PY
  else
    bootLog error "No downloader available (curl, wget or python3 required) to fetch ${url}"
    return 1
  fi
}

# sudoCmd - Run a command as root when we are not root (non-interactive sudo only)
sudoCmd() {
  if [[ "$(id -u)" == "0" ]]; then
    "$@"
  elif hasCmd sudo; then
    if isUnattended; then
      sudo -n "$@"
    else
      sudo "$@"
    fi
  else
    return 1
  fi
}

# detectPackageManager - Print the name of the system package manager
detectPackageManager() {
  local pm
  for pm in apt-get dnf yum apk pacman zypper brew; do
    if hasCmd "$pm"; then
      echo "$pm"
      return 0
    fi
  done
  return 1
}

# installPackage - Install a system package using the detected package manager
installPackage() {
  local pkg="$1" pm
  pm="$(detectPackageManager)" || {
    bootLog warn "No supported package manager found to install ${pkg}"
    return 1
  }
  bootLog info "Installing ${pkg} with ${pm}..."
  case "$pm" in
    apt-get)
      sudoCmd env DEBIAN_FRONTEND=noninteractive apt-get update -qq >/dev/null 2>&1 || true
      sudoCmd env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$pkg" >/dev/null
      ;;
    dnf) sudoCmd dnf install -y -q "$pkg" >/dev/null ;;
    yum) sudoCmd yum install -y -q "$pkg" >/dev/null ;;
    apk) sudoCmd apk add --no-cache -q "$pkg" >/dev/null ;;
    pacman) sudoCmd pacman -Sy --noconfirm --quiet "$pkg" >/dev/null ;;
    zypper) sudoCmd zypper --non-interactive --quiet install "$pkg" >/dev/null ;;
    brew) brew install "$pkg" >/dev/null ;;
    *) return 1 ;;
  esac
}

# octoflareHome - The per-user data directory used for downloaded modules and binaries
#
# OCTOFLARE_HOME, else $XDG_DATA_HOME/octoflare, else $HOME/.local/share/octoflare. There is
# deliberately no /tmp fallback: binaries and modules under a world-writable path could be
# planted by any local user, so when none of the three variables is set this exits 69.
# Always call it as home="$(octoflareHome)" || exit $?
octoflareHome() {
  if [[ -n "${OCTOFLARE_HOME:-}" ]]; then
    echo "${OCTOFLARE_HOME%/}"
  elif [[ -n "${XDG_DATA_HOME:-}" ]]; then
    echo "${XDG_DATA_HOME%/}/${PROGRAM_CODE}"
  elif [[ -n "${HOME:-}" ]]; then
    echo "${HOME%/}/.local/share/${PROGRAM_CODE}"
  else
    bootLog error "Cannot determine the ${PROGRAM_NAME} data directory: HOME, XDG_DATA_HOME and OCTOFLARE_HOME are all unset (set OCTOFLARE_HOME; /tmp is not used because it is world-writable)."
    exit 69
  fi
}

# dirIsPrivate - True when the directory exists, is owned by the current user and is
# neither group- nor world-writable (safe to put on PATH or to source modules from)
#
# The mode bits are read with ls -ld (portable between GNU and BSD); on a system
# without ls only the ownership check applies.
dirIsPrivate() {
  local dir="$1" mode
  [[ -d "$dir" && -O "$dir" ]] || return 1
  hasCmd ls || return 0
  mode="$(ls -ld "$dir" 2>/dev/null)" || return 1
  [[ "${mode:5:1}" != "w" && "${mode:8:1}" != "w" ]]
}

# sha256File - Print the SHA-256 digest of a file (sha256sum on Linux, shasum on macOS/BSD)
#
# Returns 1 when no hashing tool is available.
sha256File() {
  if hasCmd sha256sum; then
    sha256sum "$1" | awk '{print $1}'
  elif hasCmd shasum; then
    shasum -a 256 "$1" | awk '{print $1}'
  elif hasCmd openssl; then
    openssl dgst -sha256 "$1" | awk '{print $NF}'
  else
    return 1
  fi
}

# Pinned static jq release and the official SHA-256 checksums
# (https://github.com/jqlang/jq/releases/download/jq-1.7.1/sha256sum.txt).
OCTOFLARE_JQ_VERSION="1.7.1"
OCTOFLARE_JQ_BASE="https://github.com/jqlang/jq/releases/download/jq-${OCTOFLARE_JQ_VERSION}"

# jqStaticAsset - Print "<asset name> <sha256>" for the pinned jq build of a platform
#
# Arguments:
#   $1: "<os>-<arch>" as reported by uname (lowercase os)
jqStaticAsset() {
  case "$1" in
    linux-x86_64) echo "jq-linux-amd64 5942c9b0934e510ee61eb3e30273f1b3fe2590df93933a93d7c58b81d19c8ff5" ;;
    linux-aarch64|linux-arm64) echo "jq-linux-arm64 4dd2d8a0661df0b22f1bb9a1f9830f06b6f3b8f7d91211a1ef5d7c4f06a8b4a5" ;;
    linux-i386|linux-i686) echo "jq-linux-i386 bc473fd4b385789e9ce3d02a4c8df74dc988a34b20fe4e1a80da997eb360b599" ;;
    darwin-x86_64) echo "jq-macos-amd64 4155822bbf5ea90f5c79cf254665975eb4274d426d0709770c21774de5407443" ;;
    darwin-arm64) echo "jq-macos-arm64 0bbe619e663e0de2c550be2fe0d240d076799d6f8a652b70fa04aea8a8362e8a" ;;
    *) return 1 ;;
  esac
}

# installStaticBinary - Download a pinned, checksum-verified static binary as a last resort
# (no root needed). Only jq is supported: curl must come from the package manager, a
# third-party static curl would handle the API token and cannot be verified upstream.
#
# The download is verified against the embedded SHA-256 before it is made executable;
# a mismatch (or no sha256sum/shasum/openssl to verify with) fails closed.
#
# Arguments:
#   $1: command name (jq)
installStaticBinary() {
  local name="$1" platform asset url expected actual bin_dir target tmp
  platform="$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m)"
  case "$name" in
    jq)
      asset="$(jqStaticAsset "$platform")" || { bootLog error "No static jq ${OCTOFLARE_JQ_VERSION} build known for ${platform}"; return 1; }
      expected="${asset#* }"
      url="${OCTOFLARE_JQ_BASE}/${asset%% *}"
      ;;
    curl) bootLog error "curl is only installed from the package manager (no static curl download)."; return 1 ;;
    *) return 1 ;;
  esac
  bin_dir="$(octoflareHome)/bin" || exit $?
  mkdir -p "$bin_dir" || return 1
  chmod go-w "$bin_dir" 2>/dev/null || true
  target="${bin_dir}/${name}"
  tmp="${target}.download.$$"
  bootLog info "Downloading ${name} ${OCTOFLARE_JQ_VERSION} (static binary) to ${target}..."
  download "$url" "$tmp" || { rm -f "$tmp"; return 1; }
  actual="$(sha256File "$tmp")" || { rm -f "$tmp"; bootLog error "Cannot verify ${name}: no sha256sum, shasum or openssl available."; return 1; }
  if [[ "$actual" != "$expected" ]]; then
    rm -f "$tmp"
    bootLog error "Checksum mismatch for ${url}: expected ${expected}, got ${actual}. Refusing to install."
    return 1
  fi
  { chmod +x "$tmp" && mv -f "$tmp" "$target"; } || { rm -f "$tmp"; return 1; }
  export PATH="${bin_dir}:${PATH}"
  hasCmd "$name"
}

# ensureDependency - Make sure a command exists, installing it when allowed
#
# The per-user bin directory ($OCTOFLARE_HOME/bin) is added to PATH only when it is owned
# by the current user and not group/world writable. Required dependencies exit 69 when they
# cannot be provided; with mode "optional" the function returns 1 instead (warnings only).
#
# Arguments:
#   $1: command name
#   $2: package name (defaults to the command name)
#   $3: "optional" to return 1 instead of exiting when the command cannot be installed
ensureDependency() {
  local cmd="$1" pkg="${2:-$1}" mode="${3:-required}" answer="" home bin_dir
  if ! hasCmd "$cmd" && home="$(octoflareHome 2>/dev/null)"; then
    bin_dir="${home}/bin"
    if dirIsPrivate "$bin_dir"; then
      export PATH="${bin_dir}:${PATH}"
    elif [[ -d "$bin_dir" ]]; then
      bootLog warn "Ignoring ${bin_dir}: it is not owned by you or is group/world writable."
    fi
  fi
  hasCmd "$cmd" && return 0

  if ! isUnattended && [[ "${OCTOFLARE_YES:-false}" != "true" ]]; then
    if [[ -t 0 ]]; then
      printf '[prompt] %s requires "%s" which is not installed. Install it now? [Y/n] ' "$PROGRAM_NAME" "$cmd" >&2
      read -r answer
      case "$answer" in
        n|N|no|NO|No) dependencyMissing "$mode" "Cannot continue without ${cmd}. Install it and try again."; return $? ;;
      esac
    else
      dependencyMissing "$mode" "Missing dependency \"${cmd}\". Re-run with --unattended (or --yes) to install it automatically."
      return $?
    fi
  fi

  if installPackage "$pkg" 2>/dev/null && hasCmd "$cmd"; then
    bootLog success "Installed ${cmd}."
    return 0
  fi
  if installStaticBinary "$cmd"; then
    bootLog success "Installed ${cmd} (static binary in ${bin_dir})."
    return 0
  fi
  if [[ "$cmd" == "curl" ]]; then
    dependencyMissing "$mode" "Unable to install curl automatically; install it with your package manager and try again."
  else
    dependencyMissing "$mode" "Unable to install \"${cmd}\" automatically. Install it manually and try again."
  fi
}

# dependencyMissing - Report a dependency that could not be provided
#
# Arguments:
#   $1: mode (required -> log an error and exit 69; optional -> warn and return 1)
#   $2: message
dependencyMissing() {
  if [[ "$1" == "optional" ]]; then
    bootLog warn "$2"
    return 1
  fi
  bootLog error "$2"
  exit 69
}

# resolveLibDir - Find (or choose) the directory that holds the lib modules
#
# Search order:
#   1. OCTOFLARE_LIB_DIR (explicit)
#   2. <script dir>/lib           (repository checkout, GitHub Action path)
#   3. <script dir>/../lib/octoflare  (e.g. /usr/local/bin -> /usr/local/lib/octoflare)
#   4. $OCTOFLARE_HOME/lib        (per-user auto-install location)
#
# The per-user location is only used when it is owned by the current user and not
# group/world writable (modules found there are sourced). Exits 69 when nothing is
# installed and no safe per-user directory can be determined (see octoflareHome).
resolveLibDir() {
  local sdir candidate home="" home_lib=""
  sdir="$(scriptDir)"
  if home="$(octoflareHome 2>/dev/null)"; then
    home_lib="${home}/lib"
    if [[ -d "$home_lib" ]] && ! dirIsPrivate "$home_lib"; then
      bootLog warn "Ignoring modules in ${home_lib}: the directory is not owned by you or is group/world writable."
      home_lib=""
    fi
  fi
  local candidates=("${OCTOFLARE_LIB_DIR:-}" "${sdir}/lib" "${sdir}/../lib/${PROGRAM_CODE}" "$home_lib")
  for candidate in "${candidates[@]}"; do
    [[ -n "$candidate" && -f "${candidate}/core.sh" ]] && { echo "$candidate"; return 0; }
  done
  # Nothing installed yet: pick the first writable location
  for candidate in "${candidates[@]}"; do
    [[ -z "$candidate" ]] && continue
    if mkdir -p "$candidate" 2>/dev/null && [[ -w "$candidate" ]]; then
      [[ "$candidate" == "$home_lib" ]] && chmod go-w "$candidate" 2>/dev/null
      echo "$candidate"
      return 0
    fi
  done
  [[ -n "$home_lib" ]] && { echo "$home_lib"; return 0; }
  home="$(octoflareHome)" || exit $?
  bootLog error "No safe directory for the ${PROGRAM_NAME} modules: fix the permissions of ${home}/lib or set OCTOFLARE_LIB_DIR."
  exit 69
}

# fetchModule - Download a single module into the lib directory
fetchModule() {
  local name="$1" dir="$2" url tmp
  url="${OCTOFLARE_RAW_BASE}/${OCTOFLARE_REF}/src/lib/${name}.sh"
  tmp="${dir}/.${name}.sh.tmp"
  mkdir -p "$dir" 2>/dev/null || sudoCmd mkdir -p "$dir" || return 1
  if [[ -w "$dir" ]]; then
    download "$url" "$tmp" && mv "$tmp" "${dir}/${name}.sh"
  else
    # no predictable /tmp names: mktemp is required for the privileged copy
    tmp="$(mktemp "${TMPDIR:-/tmp}/octoflare.XXXXXX")" || return 1
    download "$url" "$tmp" && sudoCmd mv "$tmp" "${dir}/${name}.sh"
  fi
}

# ensureModules - Download every missing module, then source them all
ensureModules() {
  local dir="$1" name missing=""
  for name in $OCTOFLARE_MODULES; do
    [[ -f "${dir}/${name}.sh" ]] || missing="${missing} ${name}"
  done
  if [[ -n "$missing" ]]; then
    bootLog info "Installing missing ${PROGRAM_NAME} modules (${missing# }) into ${dir}..."
    for name in $missing; do
      fetchModule "$name" "$dir" || {
        bootLog error "Failed to download module \"${name}\" from ${OCTOFLARE_RAW_BASE}/${OCTOFLARE_REF}/src/lib/${name}.sh"
        exit 70
      }
    done
  fi
  for name in $OCTOFLARE_MODULES; do
    # shellcheck disable=SC1090
    source "${dir}/${name}.sh" || {
      bootLog error "Failed to load module \"${name}\" from ${dir}"
      exit 70
    }
  done
}

#####################################################################################################################VDM
######################################## Bootstrap

# Names of the variables that were really present in the environment when Octoflare started
# (env files may set anything else, including OCTOFLARE_* switches that modules default later).
OCTOFLARE_ORIG_ENV=" $(compgen -e | tr '\n' ' ') "
export OCTOFLARE_ORIG_ENV

detectUnattended "$@"

# Dependencies: curl for the Cloudflare API, jq for JSON handling.
ensureDependency curl curl
ensureDependency jq jq

if [[ "${OCTOFLARE_BUNDLED:-false}" != "true" ]]; then
  OCTOFLARE_LIB_DIR="$(resolveLibDir)" || exit $?
  export OCTOFLARE_LIB_DIR
  ensureModules "$OCTOFLARE_LIB_DIR"
fi

if [[ "${OCTOFLARE_LIB_VERSION:-}" != "$PROGRAM_VERSION" ]]; then
  bootLog warn "Module version (${OCTOFLARE_LIB_VERSION:-unknown}) differs from ${PROGRAM_NAME} v${PROGRAM_VERSION}; run '${PROGRAM_CODE} --update' to synchronise."
fi

#####################################################################################################################VDM
######################################## Run Main

octoflareMain "$@"
