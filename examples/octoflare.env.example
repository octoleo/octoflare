# Copy to ./.octoflare (project) or ~/.config/octoflare/.env (global).
# Values here never override variables already set in the environment
# (set OCTOFLARE_ENV_OVERRIDE=true to change that).

CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
# CLOUDFLARE_ACCOUNT_ID="your-account-id"
# CLOUDFLARE_DOMAIN="example.com"
# CLOUDFLARE_ZONE_ID="zone-id-to-skip-lookups"
# CLOUDFLARE_RESTORE_LEVEL="high"
# OCTOFLARE_OUTPUT="json"
